{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchtap.local/schemas/chain-dependencies-v1.json",
  "title": "LaunchTap reviewed chain dependencies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "chainId",
    "name",
    "explorerBase",
    "weth",
    "uniswapV2Factory",
    "uniswapV2Router02",
    "pairInitCodeHash",
    "bytecodeHashes",
    "forkVerification",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "chainId": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "explorerBase": { "type": "string", "minLength": 1 },
    "weth": { "$ref": "#/$defs/address" },
    "uniswapV2Factory": { "$ref": "#/$defs/address" },
    "uniswapV2Router02": { "$ref": "#/$defs/address" },
    "pairInitCodeHash": { "$ref": "#/$defs/hash" },
    "bytecodeHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weth", "uniswapV2Factory", "uniswapV2Pair"],
      "properties": {
        "weth": { "$ref": "#/$defs/hash" },
        "uniswapV2Factory": { "$ref": "#/$defs/hash" },
        "uniswapV2Pair": { "$ref": "#/$defs/hash" }
      }
    },
    "forkVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockNumber",
        "blockHash",
        "observedRpcProvider",
        "archiveRpcProvider",
        "rpcEnvironmentVariable",
        "archiveRequired"
      ],
      "properties": {
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockHash": { "$ref": "#/$defs/hash" },
        "observedRpcProvider": { "type": "string", "minLength": 1 },
        "archiveRpcProvider": { "type": "string", "minLength": 1 },
        "rpcEnvironmentVariable": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "archiveRequired": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
